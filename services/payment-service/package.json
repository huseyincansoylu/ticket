{
  "name": "@ticket/payment-service",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "echo \"payment-service: no lint configured yet\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "5.0.6",
    "@types/iyzipay": "2.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "^22.10.0",
    "jest": "30.5.2",
    "prisma": "7.10.0",
    "ts-jest": "29.4.13",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@ticket/shared-types": "workspace:*",
    "dotenv": "^18.0.3",
    "iyzipay": "^2.0.69",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
